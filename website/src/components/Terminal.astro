---
/**
 * 一个终端窗口:标题栏 + 等宽正文。正文由调用方以 HTML 传入(set:html),
 * 颜色类名对应 TUI 主题:u 用户/青,d 暗,t 工具/蓝,ok 绿,err 红,add/del 是 diff 底色。
 * 窗口始终是深色——它画的是产品真实的样子,不跟随站点的明暗切换。
 */
interface Props {
  title: string;
  html: string;
  compact?: boolean;
}
const { title, html, compact = false } = Astro.props;
---

<figure class:list={['term', { compact }]}>
  <figcaption class="bar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="title">{title}</span>
  </figcaption>
  <pre class="body" set:html={html} />
</figure>

<style>
  .term {
    margin: 0;
    background: #0e131a;
    color: #d5dde6;
    border: 1px solid #1f2933;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.6);
    font-family: var(--font-geist-mono, ui-monospace, 'SF Mono', Menlo, monospace);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.9rem;
    background: #131a22;
    border-bottom: 1px solid #1f2933;
    font-size: 0.78rem;
    color: #7c8a99;
  }
  .dots { display: inline-flex; gap: 6px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: #2a3441; }
  .body {
    margin: 0;
    padding: 1.1rem 1.25rem 1.2rem;
    font-size: 0.86rem;
    line-height: 1.55;
    overflow-x: auto;
    white-space: pre;
    tab-size: 2;
    background: transparent;
  }
  .compact .body { font-size: 0.8rem; padding: 0.9rem 1rem; }
  .body :global(.u) { color: #5eead4; }
  .body :global(.d) { color: #6b7887; }
  .body :global(.t) { color: #8ab4ff; }
  .body :global(.ok) { color: #86d99a; }
  .body :global(.err) { color: #f28b9b; }
  .body :global(.warn) { color: #e8c672; }
  .body :global(.b) { color: #eef2f6; }
  .body :global(.add) { background: #1e4023; color: #b6e3bc; display: inline-block; width: calc(100% - 5ch); }
  .body :global(.del) { background: #4a2226; color: #f2b8bd; display: inline-block; width: calc(100% - 5ch); }
  .body :global(.cur) {
    display: inline-block; width: 0.55em; height: 1.1em; vertical-align: -0.2em;
    background: #5eead4; animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .body :global(.cur) { animation: none; } }
</style>
