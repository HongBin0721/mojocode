{
  "name": "mojocode",
  "version": "0.3.0",
  "description": "A terminal coding agent that works with any LLM (Kimi / DeepSeek / GLM / ...)",
  "license": "MIT",
  "keywords": [
    "cli",
    "ai",
    "agent",
    "llm",
    "tui",
    "coding-agent"
  ],
  "type": "module",
  "bin": {
    "mojocode": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "build:bin": "bun scripts/build-binaries.ts",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:ui && npm run build",
    "test": "vitest run",
    "test:ui": "bun --bun x vitest run --config vitest.ui.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.19",
    "@ai-sdk/openai-compatible": "^3.0.20",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentui/core": "0.5.1",
    "@opentui/solid": "0.5.1",
    "ai": "^7.0.47",
    "cli-highlight": "^2.1.11",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "jpeg-js": "^0.4.4",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "node-html-markdown": "^2.0.0",
    "solid-js": "1.9.12",
    "string-width": "^8.2.2",
    "web-tree-sitter": "0.25.10",
    "wrap-ansi": "^10.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/node": "^24.0.0",
    "babel-preset-solid": "^1.9.12",
    "esbuild-plugin-solid": "^0.6.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
