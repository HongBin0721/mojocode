{
  "name": "mojocode",
  "version": "0.1.0",
  "description": "A terminal coding agent that works with any LLM (Kimi / DeepSeek / GLM / ...)",
  "license": "MIT",
  "keywords": [
    "cli",
    "ai",
    "agent",
    "llm",
    "tui",
    "coding-agent"
  ],
  "type": "module",
  "bin": {
    "mojocode": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.19",
    "@ai-sdk/openai-compatible": "^3.0.20",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.47",
    "cli-highlight": "^2.1.11",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "ink": "^7.1.1",
    "jpeg-js": "^0.4.4",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19.2.8",
    "string-width": "^8.2.2",
    "wrap-ansi": "^10.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
